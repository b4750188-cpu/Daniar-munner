# Application Configuration
PORT=3000
NODE_ENV=production
APP_URL="http://localhost:3000"

# Administrative Security
# Required to access private queue, verify/reject content, and trigger provider sync
# Configure a strong private passphrase in your server environment
ADMIN_SECRET=""

# Database Configuration (Optional)
# If provided, connects to PostgreSQL; otherwise defaults to persistent relational file database at data/tables/
# DATABASE_URL="postgresql://user:password@localhost:5432/dananeer_db"

# External Content Provider API Credentials (Optional)
# The application gracefully functions when these are empty, showing verified archives and unconfigured notices.

# YouTube Data API v3 (Google Cloud Console -> YouTube Data API v3)
# Used for real-time video discovery, channel uploads, and metadata sync
YOUTUBE_API_KEY=""

# Instagram Graph API (Meta for Developers -> Instagram Basic Display / Graph API)
# Used for verified public reel and post indexing
INSTAGRAM_ACCESS_TOKEN=""

# X / Twitter API v2 (Developer Portal -> Bearer Token)
# Used for public tweet and interview thread indexing
X_BEARER_TOKEN=""

# Snapchat Public API
# Used for public spotlight & story discover index
SNAPCHAT_API_KEY=""

# Google Gemini API Key
GEMINI_API_KEY=""
